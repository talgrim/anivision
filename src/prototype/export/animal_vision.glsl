const mat3 DOG_V2 = mat3(
    0.325424108, 0.241602767, -0.00107797787,  // column 0
    0.907572768, 0.674948223, 0.00145030881,  // column 1
    -0.232996876, 0.0834490095, 0.999627669); // column 2

// v0: Vienot, Brettel & Mollon (1999) deuteranopia matrix for linear sRGB. Fallback.
//   [ 0.2927500   0.7072500   0.0000000 ]
//   [ 0.2927500   0.7072500   0.0000000 ]
//   [-0.0223400   0.0223400   1.0000000 ]
const mat3 DOG_V0 = mat3(
